# ==============================================================================
# URBANSTYLES - VARIABLES D'ENTORN CONFIGURABLES
# ==============================================================================
# Renombra aquest fitxer a .env.local per a desenvolupament local.
# NO pugis mai les claus secretes de producció a Git.

# URL BASE DEL LLOC WEB
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PASSALEL·LA STRIPE (PAGAMENTS AMB TARGETA BANCÀRIA)
# Obtingues les teues claus de prova a https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_sample_urbanstyles_public_key"
STRIPE_SECRET_KEY="sk_test_sample_urbanstyles_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_sample_urbanstyles_webhook_secret"

# PAYPAL
# Obtingues les claus a https://developer.paypal.com/dashboard/applications/sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID="sample_paypal_client_id"

# SERVEI DE CORREU TRANSACCIONAL (Formulari de contacte i comandes)
# Proveïdor recomanat: Resend (https://resend.com) o SendGrid
RESEND_API_KEY=""
SUPPORT_EMAIL="info@urbanstyles.es"

